# Production environment variables for Railway deployment
# Set these in your Railway dashboard under Variables

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/danumadinuma?retryWrites=true&w=majority

# JWT Secrets - Generate strong random strings (required)
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<generate-64-byte-hex-secret>
JWT_REFRESH_SECRET=<generate-64-byte-hex-secret>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth (Google Cloud Console - required for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend URL - Your Vercel domain (required for CORS)
FRONTEND_URL=https://your-app.vercel.app

# SMTP for password reset emails
# Option A: Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AI Provider (mock = no external API needed)
AI_PROVIDER=mock
