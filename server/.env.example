PORT=5000
NODE_ENV=development

# MongoDB Atlas Free Tier (M0)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/danumadinuma?retryWrites=true&w=majority

# JWT Secrets
JWT_SECRET=your-jwt-secret-key-change-this
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth (Free - Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend URL
FRONTEND_URL=http://localhost:5173

# SMTP (Free - Gmail App Password or Mailtrap free tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AI Provider (mock by default - no API key needed)
AI_PROVIDER=mock
